# Copy this file to .env and fill in real values. NEVER commit .env.
#
# The app works WITHOUT these (retrieval-only mode: it shows the matching scheme text).
# To get AI-written answers, use any OpenAI-compatible chat API.
# Check your provider's docs for the exact base URL and current model names.

LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your_model_name_here

# Optional: how strict retrieval is (lower = stricter). Tune after testing.
MAX_DISTANCE=0.8
